{
  "manifest_version": 3,
  "name": "Dooray Task Reservation",
  "description": "Dooray 업무·댓글 작업(생성/수정/삭제)을 예약하고, 예약 시각에 자동으로 실행합니다.",
  "version": "1.2.2",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Dooray 예약"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dooray.com/*",
        "https://*.gov-dooray.com/*",
        "https://*.dooray.co.kr/*",
        "https://*.gov-dooray.co.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "notifications", "unlimitedStorage"],
  "host_permissions": [
    "https://*.dooray.com/*",
    "https://*.gov-dooray.com/*",
    "https://*.dooray.co.kr/*",
    "https://*.gov-dooray.co.kr/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
